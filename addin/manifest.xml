<?xml version="1.0" encoding="UTF-8"?>
<!-- Exam Timer: PowerPoint content add-in. The page itself is hosted on GitHub Pages. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>f0e1e756-f2fd-43ae-9a8b-260572d614c7</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>maradens</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Exam Timer"/>
  <Description DefaultValue="Free countdown timer for exams. Shows time left on the slide, with colour warnings and a time's-up alert."/>
  <IconUrl DefaultValue="https://maradens.github.io/exam-timer/addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://maradens.github.io/exam-timer/addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/maradens/exam-timer"/>
  <AppDomains>
    <AppDomain>https://maradens.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://maradens.github.io/exam-timer/addin/index.html"/>
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
